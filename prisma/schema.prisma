// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String       @id @default(cuid())
  name          String?
  telegramUsername String?      @unique
  image         String?
  telegramPhotoUrl String?
  password      String?
  goal          String?
  isPrivate     Boolean      @default(false)
  totalDistance Float        @default(0)
  weeklyGoal    Float        @default(15)
  notifyClubEvents Boolean   @default(true)
  onboardingSeenMask Int     @default(0)
  createdAt     DateTime     @default(now())
  
  accounts      Account[]
  sessions      Session[]
  runs          Run[]
  clubMembers   ClubMember[]
  eventsCreated Event[]      @relation("EventCreator")
  eventsAttended Event[]     @relation("EventAttendees")
  eventsCheckedIn Event[]    @relation("EventCheckedIn")
  
  runProposals  RunProposal[] @relation("RunProposalCreator")
  joinRequests  RunJoinRequest[] @relation("JoinRequestUser")
  
  posts         Post[]
  likes         Like[]
  comments      Comment[]

  challengeParticipations ChallengeParticipation[]
}

model Run {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  distance      Float    @default(0) // in km
  durationSec   Int      @default(0)
  avgPace       Float    @default(0) // min/km (calculated or stored)
  status        String   @default("COMPLETED") // "IN_PROGRESS" | "COMPLETED"
  routeData     String?  // JSON stringified coordinates
  startTime     DateTime @default(now())
  
  eventId       String?
  event         Event?   @relation("EventRuns", fields: [eventId], references: [id], onDelete: SetNull)
  splits        String?  // JSON stringified array
  
  post          Post?

  @@index([userId])
  @@index([startTime])
}

model Club {
  id                String       @id @default(cuid())
  name              String
  description       String?
  logoConfig        String?      // JSON stringified
  joinType          String       @default("OPEN") // "OPEN" | "APPLICATION" | "INVITE_ONLY"
  tags              String?      // JSON stringified array
  totalClubDistance Float        @default(0)
  createdAt         DateTime     @default(now())
  
  members           ClubMember[]
  events            Event[]
}

model ClubMember {
  id            String   @id @default(cuid())
  userId        String
  clubId        String
  role          String   @default("MEMBER") // "MEMBER" | "PACER" | "OFFICER" | "FOUNDER"
  status        String   @default("ACTIVE") // "PENDING" | "ACTIVE" | "KICKED"
  joinedAt      DateTime @default(now())
  clubDistance  Float    @default(0)

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  club          Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  
  @@unique([userId, clubId])
  @@index([clubId, status])
  @@index([userId, status])
}

model Event {
  id            String   @id @default(cuid())
  clubId        String?
  creatorId     String
  title         String
  description   String?
  location      String
  date          DateTime
  distance      Float?
  pace          String?  // e.g. "5:00-5:30" or JSON array
  routeData     String?  // JSON stringified coordinates
  image         String?
  showOnMap     Boolean  @default(true)
  checkInToken  String?  @unique
  reminderSent  Boolean  @default(false)
  createdAt     DateTime @default(now())
  
  club          Club?    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  creator       User     @relation("EventCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  attendees     User[]   @relation("EventAttendees")
  checkedInUsers User[]  @relation("EventCheckedIn")
  runs          Run[]    @relation("EventRuns")

  @@index([date])
  @@index([clubId])
}

model RunProposal {
  id              String   @id @default(cuid())
  creatorId       String
  lat             Float
  lng             Float
  address         String?
  routeData       String?  // JSON stringified coordinates
  pace            String?
  startTime       DateTime
  maxParticipants Int      @default(0) // 0 means no limit
  status          String   @default("ACTIVE") // ACTIVE, CANCELLED, COMPLETED
  reminderSent    Boolean  @default(false)
  createdAt       DateTime @default(now())

  creator         User     @relation("RunProposalCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  requests        RunJoinRequest[] @relation("RunJoinRequests")

  @@index([status, startTime])
  @@index([creatorId])
}

model RunJoinRequest {
  id              String   @id @default(cuid())
  proposalId      String
  userId          String
  status          String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt       DateTime @default(now())

  proposal        RunProposal @relation("RunJoinRequests", fields: [proposalId], references: [id], onDelete: Cascade)
  user            User        @relation("JoinRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([proposalId, userId])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Post {
  id            String   @id @default(cuid())
  userId        String
  type          String   // "RUN" | "ACHIEVEMENT" | "TEXT" | "MEDIA"
  runId         String?  @unique
  content       String?
  mediaUrl      String?
  createdAt     DateTime @default(now())
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  run           Run?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  likes         Like[]
  comments      Comment[]

  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

model Like {
  id            String   @id @default(cuid())
  userId        String
  postId        String
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model Challenge {
  id          String   @id @default(cuid())
  slug        String   @unique
  partner     String
  title       String
  metric      String   // "KM" | "STREAK"
  target      Float
  city        String   @default("Везде")
  claimType   String   @default("PROMO") // "PROMO" | "QR"
  rewardLabel String
  isActive    Boolean  @default(true) // показывать ли в каталоге
  createdAt   DateTime @default(now())

  participations ChallengeParticipation[]
  promoCodes     PromoCode[]
}

model ChallengeParticipation {
  id           String    @id @default(cuid())
  userId       String
  challengeId  String
  status       String    @default("ACTIVE") // "ACTIVE" | "PAUSED" | "COMPLETED"
  progress     Float     @default(0)
  activatedAt  DateTime  @default(now()) // километры считаются только с этого момента
  completedAt  DateTime?
  rewardSentAt DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([userId, status])
  @@index([challengeId, status])
}

model PromoCode {
  id          String    @id @default(cuid())
  challengeId String
  code        String
  status      String    @default("AVAILABLE") // "AVAILABLE" | "CLAIMED"
  claimedById String?
  claimedAt   DateTime?

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, code])
  @@index([challengeId, status])
}

model Comment {
  id            String   @id @default(cuid())
  userId        String
  postId        String
  content       String
  mediaUrl      String?
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}
